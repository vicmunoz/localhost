-- Align lock system binding with macos
hl.unbind("SUPER + CTRL + Q")
hl.unbind("SUPER + CTRL + L")
o.bind("SUPER + CTRL + Q", "Lock system", "omarchy-system-lock")

-- Align tiling bindings with macos
-- omarchy defaults are in /usr/share/omarchy/default/hypr/bindings/tiling.lua
for workspace = 1, 10 do
  local key = "code:" .. tostring(workspace + 9)
  hl.unbind("SUPER + " .. key)
  o.bind("SUPER + CTRL + SHIFT + ALT + " .. key, "Switch to workspace " .. workspace, hl.dsp.focus({ workspace = tostring(workspace) }))
  hl.unbind("SUPER + SHIFT + " .. key)
  o.bind("CTRL + SHIFT + ALT + " .. key, "Move window to workspace " .. workspace, hl.dsp.window.move({ workspace = tostring(workspace) }))
  hl.unbind("SUPER + SHIFT + ALT + " .. key)
end

hl.unbind("ALT + TAB")
o.bind("ALT + SHIFT + K", "Focus on next window", hl.dsp.window.cycle_next())
hl.unbind("ALT + SHIFT + TAB")
o.bind("ALT + SHIFT + J", "Focus on previous window", hl.dsp.window.cycle_next({ next = false }))

