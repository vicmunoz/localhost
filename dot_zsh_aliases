###########################
# Personal custom aliases #
###########################
alias vicnotespull='cd ~/notes; ggpull; cd ;'
alias vicnotespush='cd ~/notes; gaa; gctime; ggpush; cd ;'
alias vicyadmpull='cd ~; ypull;'
alias vicyadmpush='cd ~; yall; yctime; ypush;'
alias vicfullpull='vicnotespull; vicyadmpull;'
alias vicfullpush='vicnotespush; vicyadmpush;'

##################
# Docker aliases #
##################
alias dex='docker exec -i -t'                                               # Execute interactive container
alias di='docker images'                                                    # List docker images
alias dip='docker inspect --format "{{ .NetworkSettings.IPAddress }}"'      # Get container IP
alias dkd='docker run -d -P'                                                # Run container as daemon
alias dkd64='docker run --platform linux/amd64 -d -P'                       # Run  container as daemon for platform amd64
alias dki='docker run -i -t -P'                                             # Run interactive container
alias dki64='docker run --platform linux/amd64 -i -t -P'                    # Run interactive container for platform amd64
alias dpa='docker ps -a'                                                    # List all containers, including stopped ones
alias dps='docker ps'                                                       # List containers
alias dpull='docker pull'                                                   # Pull container image
alias dpull64='docker pull --platform linux/amd64'                          # Pull container image for platform amd64
alias dri='docker rmi $(docker images -q)'                                  # Remove all images
alias driu='docker rmi $(docker images -f "dangling=true" -q)'              # Remove all images untagged
alias drm='docker rm $(docker ps -a -q)'                                    # Remove all containers
alias drmf='docker stop $(docker ps -a -q) ; docker rm $(docker ps -a -q)'  # Stop and Remove all containers
alias dstop='docker stop $(docker ps -a -q)'                                # Stop all containers

###############
# Git aliases #
###############
# Functions required
#
# Show commit messages for current branch, diff with master
# Output git's commits messages for current branch only
__git.commits_current_branch() {
  echo "Changes in this MR:"; git log --pretty=tformat:"- %s" --no-merges "$(git branch --show-current)" ^"$(git remote show origin | sed -n '/HEAD branch/s/.*: //p')" | sort | uniq
}
