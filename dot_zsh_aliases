alias cz='chezmoi'
# alias catjson - see .zsh_functions
alias grep='grep --color=always'
alias ll='lsd -l'
alias ls='lsd'
# alias ping_ssh - see .zsh_functions
alias sedi='sed -i.sed.bak'
